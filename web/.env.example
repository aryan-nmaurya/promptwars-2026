# Copy to .env.local and fill in. Never commit .env.local.

# The deployed FastAPI origin. No trailing slash.
# Local:  http://localhost:8000
# Vercel: https://<your-api-project>.vercel.app
#
# NEXT_PUBLIC_* is inlined into the JavaScript the browser downloads.
# It is PUBLIC. Never put an API key, token, or database URL in one.
NEXT_PUBLIC_API_URL=http://localhost:8000
