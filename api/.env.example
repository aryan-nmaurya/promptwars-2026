# Copy to .env and fill in. Never commit .env.

# Postgres. Paste the provider's string verbatim - the scheme is rewritten to
# postgresql+asyncpg://, libpq-only params (sslmode, channel_binding, pgbouncer)
# are stripped, TLS is enabled for remote hosts, and pooled endpoints are
# detected and made PgBouncer-safe. See app/db.py.
#
#   Local (Homebrew, trust auth):  postgresql://<your-mac-username>@localhost:5432/promptwars_dev
#   Local (Docker-style password): postgresql://postgres:postgres@localhost:5432/app
#   Neon / Vercel Postgres:        postgresql://user:pass@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
#   Supabase:                      postgresql://postgres.<ref>:pass@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# In production always use the POOLED endpoint (the one with `-pooler`, or port
# 6543). Serverless opens a connection per invocation; the pooler is what keeps
# you under max_connections.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Comma-separated. Must include the exact web origin, scheme and all, no
# trailing slash. Add your Vercel preview + production domains in production.
ALLOWED_ORIGINS=http://localhost:3000

# Optional, server-side only. Never mirror this into a NEXT_PUBLIC_* var.
GOOGLE_API_KEY=

# development | test | preview | production
ENV=development

# Gemini. Models are tried in order; each gets GEMINI_RETRIES retries.
# Idea generation runs ~6s from Vercel, but roadmap generation is heavier and
# has exceeded 8s, so the budget is 20s. Worst case is 2 models x 20s = 40s,
# inside vercel.json's maxDuration of 60. Timeouts are never retried - only
# transient errors are.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_RETRIES=1

# How long an identical (interests, skills) pair reuses its generation.
IDEAS_CACHE_TTL_SECONDS=600
