# Copy to .env and fill in. Never commit .env.

# Postgres. `postgres://` and `postgresql://` are rewritten to the async driver
# automatically, and libpq-only params (sslmode, channel_binding) are handled.
# Local:  postgresql://postgres:postgres@localhost:5432/app
# Vercel: use the POSTGRES_URL / DATABASE_URL value from the storage tab.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Comma-separated. Must include the exact web origin, scheme and all, no
# trailing slash. Add your Vercel preview + production domains in production.
ALLOWED_ORIGINS=http://localhost:3000

# Optional, server-side only. Never mirror this into a NEXT_PUBLIC_* var.
GOOGLE_API_KEY=

# development | test | preview | production
ENV=development
